# ---------------------------------------------------------------------------
# ClickHouse (the one from this project's docker-compose)
# ---------------------------------------------------------------------------
CH_HOST=localhost
# Port on the HOST (compose maps 8124 -> the container's 8123)
CH_PORT=8124
CH_USER=va
CH_PASSWORD=va
# Two databases inside the same server - see the comment in docker-compose.yml
CH_LAKE_DB=lake
CH_ANALYSIS_DB=analysis

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_SECRET_KEY=dev-do-not-use-in-production
FLASK_DEBUG=1
# Upload ceiling in MB. A screening .raw is usually 80-150 MB; the ceiling
# applies to the WHOLE REQUEST, so uploading 20 samples at once needs room for
# all 20 combined.
MAX_UPLOAD_MB=8192

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# Extra mass tolerance applied on top of the substance's mass_range.
# LEAVE IT EMPTY. The mass_range is already computed from the configured
# mass_error_ppm; filling this in DOUBLES the tolerance. It exists only to
# reproduce MSFileReader's SetMassTolerance(units=1) during an investigation.
MASS_TOLERANCE_PPM=
